{
  "extends": ["../../biome.json"],
  "files": {
    "includes": [
      "src/**/*.tsx",
      "src/**/*.ts",
      "src/**/*.css",
      "scripts/*.mjs",
      "vite.config.ts",
      "package.json",
      "tsconfig.json",
      "biome.json"
    ]
  },
  "vcs": {
    "enabled": false
  },
  "root": false,
  "overrides": [
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    }
  ]
}
