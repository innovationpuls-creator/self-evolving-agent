{
  "name": "self-evolving-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json && tsc -p tsconfig.check.json",
    "lint": "biome lint",
    "format": "biome format --write",
    "format:check": "biome format",
    "start": "node dist/host/main.js",
    "desktop": "electron dist/desktop/main.js",
    "test": "tsx --test tests/*.test.ts",
    "test:real": "tsx scripts/real-smoke.ts",
    "test:ui": "npm run build && tsx scripts/ui-smoke.ts",
    "package:desktop": "npm run build && tsx scripts/package-desktop.ts",
    "test:desktop": "tsx scripts/desktop-smoke.ts",
    "test:browser": "tsx scripts/browser-smoke.ts",
    "test:skills:browser": "tsx scripts/skills-browser-smoke.ts",
    "test:skills:ui": "tsx scripts/skills-ui-smoke.ts",
    "test:d4:real": "tsx scripts/d4-real-acceptance.ts",
    "test:d4:desktop": "tsx scripts/d4-desktop-acceptance.ts",
    "test:d6:ui": "tsx scripts/d6-client-smoke.ts",
    "data": "tsx scripts/data-maintenance.ts",
    "test:d5:data": "tsx --test tests/data-maintenance.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "proper-lockfile": "4.1.2",
    "ws": "8.22.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electron/osx-sign": "2.7.1",
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.0.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "playwright-core": "^1.58.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "main": "dist/desktop/main.js"
}
